NODE_ENV=development
PORT=5000
LOG_LEVEL=info

# The single trusted browser origin (credentials-enabled CORS + CSRF Origin check).
CLIENT_URL=http://localhost:3001

DATABASE_URL=postgresql://USER:PASSWORD@localhost:5435/garment_dev
# Integration tests only. Tests DROP and recreate the public schema of this database.
TEST_DATABASE_URL=postgresql://USER:PASSWORD@localhost:5435/garment_test

# >= 32 random characters: node -e "console.log(require('crypto').randomBytes(48).toString('base64url'))"
CSRF_SECRET=replace-with-at-least-32-random-characters

# "false", a hop count (e.g. 1), or comma-separated trusted proxies ("loopback", "10.0.0.0/8"). Never "true".
TRUST_PROXY=loopback

SESSION_IDLE_TIMEOUT_MINUTES=120
SESSION_ABSOLUTE_TIMEOUT_HOURS=12

# outbox (development: JSON files in MAIL_OUTBOX_DIR) | resend (production)
MAIL_TRANSPORT=outbox
MAIL_OUTBOX_DIR=.outbox
MAIL_FROM=Garment Manager <no-reply@localhost>
RESEND_API_KEY=

# One-time owner bootstrap (npm run bootstrap:owner). Remove afterwards.
BOOTSTRAP_OWNER_EMAIL=
BOOTSTRAP_OWNER_NAME=
BOOTSTRAP_OWNER_PASSWORD=
